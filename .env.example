# Firebase project: Firebase Console > Project settings > General
FIREBASE_PROJECT_ID=your-firebase-project-id

# Firestore Database ID; use (default) unless you created a named database.
FIRESTORE_DATABASE_ID=(default)

# Download a Firebase Admin SDK service-account JSON key and keep it out of source control.
FIREBASE_CREDENTIALS_PATH=secrets/firebase-service-account.json

FRONTEND_ORIGIN=http://localhost:5173
SESSION_COOKIE_SECURE=false
SERVER_PORT=8080

# Optional SMTP settings for password-reset email.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@your-domain.example
PASSWORD_RESET_URL=http://localhost:5173/reset-password

SCAN_RETENTION_DAYS=90
LOGIN_ATTEMPT_LIMIT=10
LOGIN_WINDOW_MINUTES=15